# Copy this file to .env and fill in the values. .env is git-ignored: never commit it.

# Database (defaults match docker-compose.yml)
DB_PORT=5432
DB_NAME=copilot
DB_USER=copilot
DB_PASSWORD=copilot

# JWT signing secret: at least 32 characters, required (the app will not start without it).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl

# Gemini API key, used for document embeddings (ingestion). Never commit a real key.
# Any dummy value is enough to start the app; ingesting documents needs a real key.
GEMINI_API_KEY=change-me
